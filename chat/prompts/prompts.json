    "AQ_Joint": {
      "description": "Argument Quality Assessment: Joint",
      "variables": ["text"],
      "json_object": true,
      "languages": {
        "en": {
          "path_system": "./chat/prompt/quality_prompt_LDR.en.txt",
          "user": "Evaluate the argument quality of the following text: \n{{text}}"
        }
      }
    }
  }
}